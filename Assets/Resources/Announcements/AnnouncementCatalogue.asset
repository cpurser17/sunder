      - language: en
        clip: {fileID: 8300000, guid: 10356dc4bfc79f349a0854d9fc69b173, type: 3}
    - variant: Rare
      weight: 1
      texts:
      - language: en
        text: Minions voluntarily despawning really says something about your leadership.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: ef28d7e506937f24c91f67cc7aff5095, type: 3}
  - id: NoLair
    priority: 1
    cooldown: 30
    lines:
    - variant: 1
      weight: 49.5
      texts:
      - language: en
        text: You need a lair.
