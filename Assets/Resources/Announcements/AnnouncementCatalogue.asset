    - variant: 2
      weight: 49.5
      texts:
      - language: en
        text: Your lair needs to be bigger.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 0f234ec351ca39e4e87f577943b07d6c, type: 3}
    - variant: Rare
      weight: 1
      texts:
      - language: en
        text: Your minions are sleeping on the floor. Again.
