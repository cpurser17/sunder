  defaultLanguage: en
  announcements:
  - id: MinionsUnderAttack
    priority: 3
    cooldown: 20
    lines:
    - variant: 1
      weight: 49.5
      texts:
      - language: en
        text: Your minions are under attack!
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 73209c72172c5384e90abe0545d7e4ad, type: 3}
    - variant: 2
      weight: 49.5
      texts:
      - language: en
        text: Some of your minions are in danger.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 07b05d0e4699f05439949b662b8b883b, type: 3}
    - variant: Rare
      weight: 1
      texts:
      - language: en
        text: Violence is prevalent.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 52d955e1bcd38274c83507552ecb1a42, type: 3}
  - id: HeartUnderAttack
    priority: 3
    cooldown: 20
    lines:
    - variant: 1
      weight: 49.5
      texts:
      - language: en
        text: Your Dungeon Heart is under attack!
      clips:
      - language: en
        clip: {fileID: 8300000, guid: f677143cd50582849a0ffa7c2e5cc7cd, type: 3}
    - variant: 2
      weight: 49.5
      texts:
      - language: en
        text: The core of your dungeon is in danger!
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 366c50d3250f90343966a61d3374145a, type: 3}
    - variant: Rare
      weight: 1
      texts:
      - language: en
        text: If you do not tend to your heart, you will lose it.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 7ff5b1691d2dc0e4190da936abff968b, type: 3}
  - id: MinionLeaving
    priority: 2
    cooldown: 10
    lines:
    - variant: 1
      weight: 49.5
      texts:
      - language: en
        text: A minion is leaving your dungeon.
      clips:
      - language: en
        clip: {fileID: 8300000, guid: 9adb02849968c5b42be82fbfedfe4e74, type: 3}
    - variant: 2
      weight: 49.5
      texts:
      - language: en
        text: Minions are abandoning the war effort.
